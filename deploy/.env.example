# DB
DB_ROOT_PASSWORD=change-me-root
DB_PASSWORD=change-me-app

# Google OAuth 2.0 / OIDC (Google Cloud Console で発行)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_HOSTED_DOMAIN=st.kobedenshi.co.jp

# Portal <-> FreeRADIUS 間の HTTP Bearer トークン (rlm_rest が認証 API を呼ぶときに使用)
RADIUS_SHARED_SECRET=change-me-portal-bearer

# WLC (Cisco Catalyst 9800-CL) <-> FreeRADIUS 間の RADIUS shared secret
# Catalyst 9800-CL の `radius server <name>` の `key` と完全一致させる。
WLC_SHARED_SECRET=change-me-wlc-radius-secret

# Vault AppRole (Vault 初期化スクリプトの出力を貼り付ける)
VAULT_ROLE_ID=
VAULT_SECRET_ID=
